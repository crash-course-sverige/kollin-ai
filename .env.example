# Copy to .env.local. Never commit real values.

# --- AI Gateway -------------------------------------------------------------
# Without credentials the chat runs in DEMO MODE (scripted replies, same UI).
# Local: create a key at vercel.com > AI Gateway and paste it here.
# On Vercel: leave empty, an OIDC token is injected automatically.
AI_GATEWAY_API_KEY=

# --- Model tiers (optional overrides) ---------------------------------------
# Defaults live in src/lib/ai/models.ts and are UNVERIFIED. List what the
# Gateway really serves with `pnpm ai:models`, then set the exact IDs here.
# AI_MODEL_ROUTER=
# AI_MODEL_FAST=
# AI_MODEL_DEEP=

# Comma separated fallback models tried if the primary cannot serve a request.
# AI_FALLBACK_MODELS=

# Set to 1 to route only to zero-data-retention providers (paid Gateway add-on).
# AI_ZDR=1

# Public URL used for absolute links and metadata.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
